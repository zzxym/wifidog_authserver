# Flask配置
FLASK_HOST=0.0.0.0
# AuthServer 监听端口（锐捷AC配置时填写此端口）
AUTHSERVER_PORT=5000
FLASK_DEBUG=True

# Active Directory LDAP配置
AD_SERVER=ldap://your-ad-server.domain.com
AD_BIND_DN=cn=admin,dc=domain,dc=com
AD_BIND_PASSWORD=your_password
AD_BASE_DN=dc=domain,dc=com
AD_USER_FILTER=(sAMAccountName={username})
AD_USER_BASE_DN=ou=Users,dc=domain,dc=com

# 搜索用户时使用的属性
AD_USERNAME_ATTR=sAMAccountName
AD_EMAIL_ATTR=mail
AD_DISPLAY_NAME_ATTR=displayName

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WiFiDog配置（AUTHSERVER_URL 的端口会自动与 AUTHSERVER_PORT 保持一致）
WIFIDOG_GATEWAY_ID=default
AUTHSERVER_URL=http://your-authserver:5000

# 设备限制配置（默认每个用户最多N个设备）
DEFAULT_MAX_DEVICES=3

# Token有效期（秒），默认8小时
TOKEN_EXPIRE_SECONDS=28800

# 心跳间隔（秒），WiFiDog默认基于此间隔
CHECK_INTERVAL=60

# ===== 自动清理配置 =====
# 设备超过多少小时没有心跳，视为僵尸设备并自动清理（默认7天=168小时）
DEVICE_IDLE_TIMEOUT_HOURS=168

# 自动清理的 cron 表达式（默认每天0点执行）
# 格式：分 时 日 月 周  （与系统 crontab 一致）
# 例：每天0点   = 0 0 * * *
#     每12小时   = 0 */12 * * *
#     每周一0点  = 0 0 * * 1
#     每30分钟   = */30 * * * *
DEVICE_CLEANUP_CRON=0 0 * * *

# 自动清理是否启用（True / False）
DEVICE_CLEANUP_ENABLED=True

# 管理接口安全令牌（调用 /admin/cleanup 接口需要带上，建议设置复杂字符串）
ADMIN_TOKEN=change_this_to_a_strong_random_token
