# ============================================
# WiFiDog AuthServer 运行配置
# 将此文件重命名为 .env 后，放在可执行文件同目录
# ========================================

# ----- AD域配置 -----
# AD域控制器地址 (格式: ldap://DC_IP 或 ldaps://DC_IP)
AD_SERVER=ldap://192.168.1.10

# 服务账号DN (用于绑定AD)
AD_BIND_DN=cn=wifidog_svc,cn=Users,dc=yourdomain,dc=com

# 服务账号密码
AD_BIND_PASSWORD=your_service_password

# 搜索基准DN
AD_BASE_DN=dc=yourdomain,dc=com

# 用户登录时查找的属性 (sAMAccountName 或 userPrincipalName)
AD_USER_FILTER=sAMAccountName

# 是否允许匿名绑定 (一般填 False)
AD_BIND_ANONYMOUS=False


# ----- AuthServer 配置 -----
# 服务监听地址
AUTHSERVER_HOST=0.0.0.0

# 服务监听端口
AUTHSERVER_PORT=5000

# 对外访问URL (锐捷AC回调用，填此服务器的IP或域名)
AUTHSERVER_URL=http://192.168.1.100:5000


# ----- WiFiDog 配置 -----
# Token有效期（秒），默认8小时
TOKEN_EXPIRE_SECONDS=28800

# 心跳间隔（秒），WiFiDog默认基于此间隔
CHECK_INTERVAL=60


# ----- 设备管理配置 -----
# 每个用户默认最多允许同时在线设备数
DEFAULT_MAX_DEVICES=3


# ----- 自动清理配置 -----
# 设备超过多少小时没有心跳，视为僵尸设备并自动清理（默认7天=168小时）
DEVICE_IDLE_TIMEOUT_HOURS=168

# 自动清理的 cron 表达式（默认每天0点执行）
# 格式：分 时 日 月 周  （与系统 crontab 一致）
# 例：每天0点   = 0 0 * * *
#     每12小时   = 0 */12 * * *
#     每周一0点  = 0 0 * * 1
DEVICE_CLEANUP_CRON=0 0 * * *

# 自动清理是否启用（True / False）
DEVICE_CLEANUP_ENABLED=True


# ----- 管理配置 -----
# 管理接口安全令牌（必须设置！否则管理页面无法登录）
# 建议设置为一个复杂的随机字符串
ADMIN_TOKEN=change_this_to_a_strong_random_token
